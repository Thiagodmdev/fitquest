rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidName(value) {
      return value is string && value.size() > 0 && value.size() <= 100;
    }

    function isValidWorkout(data) {
      return data.keys().hasOnly(['name', 'date', 'durationMin', 'exercises', 'createdAt'])
        && data.keys().hasAll(['name', 'date', 'durationMin', 'exercises', 'createdAt'])
        && isValidName(data.name)
        && data.date is string
        && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.durationMin is number
        && data.durationMin >= 0
        && data.exercises is list
        && data.exercises.size() <= 50
        && data.createdAt is number;
    }

    function isValidRoutine(data) {
      return data.keys().hasOnly(['name', 'exercises', 'createdAt'])
        && data.keys().hasAll(['name', 'exercises', 'createdAt'])
        && isValidName(data.name)
        && data.exercises is list
        && data.exercises.size() <= 50
        && data.createdAt is number;
    }

    match /users/{uid}/workouts/{workoutId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidWorkout(request.resource.data);
    }

    match /users/{uid}/routines/{routineId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidRoutine(request.resource.data);
    }
  }
}
